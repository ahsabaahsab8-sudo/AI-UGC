# ==============================================================================
# AI UGC Ads Generator — Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your real API keys before running.

# ─── Google Gemini API Key (Veo 3.1 & Nano/Flash Image Generation) ────────────
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Kilo Code Gateway (Prompt Synthesis) ────────────────────────────────────
# Free gateway for LLM prompt generation
KILO_PROMPT_API_KEY=your_kilo_prompt_api_key_here
KILO_PROMPT_MODEL=nex-agi/nex-n2.5-pro:free

# ─── Kilo Code Gateway (Vision / Image Inspection) ───────────────────────────
# Vision model for product image analysis
KILO_VISION_API_KEY=your_kilo_vision_api_key_here
KILO_VISION_MODEL=dots-studio/dots-3-note-preview:free

# ─── Google Sheets Integration (Optional) ─────────────────────────────────────
# Leave empty if using built-in SQLite queue
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ─── Kie.ai API Key (Veo 3.1, Nano & Sora Generation Backup) ─────────────────
KIE_AI_API_KEY=your_kie_ai_api_key_here

# ─── Worker Settings ──────────────────────────────────────────────────────────
# Polling interval in seconds for background queue daemon
WORKER_POLL_INTERVAL=10

# ─── Telegram Bot Token (Optional Notifications) ──────────────────────────────
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

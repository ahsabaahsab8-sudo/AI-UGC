# Google Gemini API Key (Veo 3.1 & Image Generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Kilo Code Gateway for Prompt Generation
KILO_PROMPT_API_KEY=your_kilo_prompt_api_key_here
KILO_PROMPT_MODEL=nex-agi/nex-n2.5-pro:free

# Kilo Code Gateway for Vision / Image Analysis
KILO_VISION_API_KEY=your_kilo_vision_api_key_here
KILO_VISION_MODEL=dots-studio/dots-3-note-preview:free

# Optional: Kie.ai API Key
KIE_AI_API_KEY=

# Polling Interval in seconds for Daemon Mode
WORKER_POLL_INTERVAL=10
